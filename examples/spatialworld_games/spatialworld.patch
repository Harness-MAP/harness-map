+
+def limit_images_in_history(
+    conversation_history: List[Dict[str, Any]],
+    max_images: Optional[int],
+) -> List[Dict[str, Any]]:
+    """Return a copy of `conversation_history` carrying at most `max_images` images.
+
+    Images are dropped OLDEST-first (their surrounding text is kept; each dropped
+    image is replaced by a short text placeholder), so the most recent `max_images`
+    frames — including the current observation in the final message — are always
+    retained. Never mutates the input (the caller reuses it as persistent history).
+    A `max_images` of None or negative means "no limit" and returns the input as-is.
