{
  "testbed": "simworld-mmnav",
  "search": {
    "mode": "adaptive",
    "k0": 4,
    "budget": 16,
    "children": 1,
    "m": 0.5,
    "strict_coverage": false
  },
  "benchmark": {
    "evaluate": "\"$SIMWORLD_PYTHON\" \"$NAV_EVALUATOR\" --harness {harness} --tasks {tasks} --out {out}",
    "search_split": "search_hard",
    "holdout_split": "val_hard",
    "timeout_s": 64800,
    "judge": false
  },
  "splits": {
    "search_hard": "tests/simworld_nav/tasks/task_spec/search_val_test_split.json#search_hard_50",
    "val_hard":    "tests/simworld_nav/tasks/task_spec/search_val_test_split.json#val_hard_10",
    "search_easy": "tests/simworld_nav/tasks/task_spec/search_val_test_split.json#search_easy_50",
    "val_easy":    "tests/simworld_nav/tasks/task_spec/search_val_test_split.json#val_easy_10"
  },
  "score_file": "score.json",
  "diag_file": "diagnostics_summary.json",
  "fitness": {
    "primary": "SubtaskSR",
    "vector": "per_position_SR",
    "dense": {
      "sr": "SR",
      "subtask_sr": "SubtaskSR",
      "distance_progress": "distance_progress_mean"
    },
    "dense_from_diag": {
      "progress_score": "progress_score"
    },
    "cost": "cost_per_episode",
    "n": "n_episodes"
  },
  "episode": {
    "list_key": "per_episode",
    "task_id": "episode",
    "primary": "success",
    "dense": {
      "subtask_sr": "subtask_sr",
      "distance_progress": "distance_progress",
      "final_dist": "final_dist_to_target"
    },
    "cost": "total_tokens"
  },
  "rubric_labels": ["ORIENTATION", "MOVE_ALONG_ROAD", "TURN_AT_INTERSECTION", "REACH_DESTINATION"],
  "noise_fields": ["primary", "subtask_sr", "distance_progress"],
  "selection": {
    "greedy_key": [
      ["primary", "desc"],
      ["dense.subtask_sr", "desc"],
      ["dense.progress_score", "desc"],
      ["taint", "asc"],
      ["judge", "asc"],
      ["dense.distance_progress", "desc"],
      ["cost", "asc"]
    ]
  },
  "audit": {
    "taint_file": "read_audit.json",
    "judge_file": "judge.json",
    "verdict_key": "verdict",
    "privileged_keys": ["agent_location", "target_location", "gt.json", "ideal_path", "current_instruction"]
  },
  "meta_agent": {
    "backbone": "cli:claude",
    "timeout_s": 10800
  }
}
