{
  "testbed": "spatialworld-3dgames",
  "search": {
    "mode": "adaptive",
    "k0": 4,
    "budget": 50,
    "m": 0.5,
    "strict_coverage": true
  },
  "benchmark": {
    "evaluate": "\"$GAME_PYTHON\" \"$GAME_EVALUATOR\" --harness {harness} --tasks {tasks} --out {out}",
    "search_split": "maze",
    "holdout_split": null,
    "timeout_s": 36000,
    "judge": false
  },
  "splits": {
    "maze":          "tests/spatialworld_games/tasks/task_spec/maze_evolve.json",
    "block3d":       "tests/spatialworld_games/tasks/task_spec/block3d_evolve.json",
    "maze3d_pro":    "tests/spatialworld_games/tasks/task_spec/maze3d_pro_evolve.json",
    "rubik":         "tests/spatialworld_games/tasks/task_spec/rubik_evolve.json",
    "snake":         "tests/spatialworld_games/tasks/task_spec/snake_evolve.json",
    "snake_holdout": "tests/spatialworld_games/tasks/task_spec/snake_eval.json"
  },
  "score_file": "score.json",
  "fitness": {
    "primary": "score",
    "n": "n_episodes",
    "valid": "rows"
  },
  "episode": {
    "list_key": "per_episode",
    "task_id": "task_id",
    "primary": "score"
  },
  "selection": {
    "greedy_key": [
      ["primary", "desc"],
      ["taint", "asc"],
      ["judge", "asc"],
      ["cost", "asc"]
    ]
  },
  "audit": {
    "taint_file": "read_audit.json",
    "judge_file": "judge.json",
    "verdict_key": "verdict",
    "privileged_keys": [
      "gt.json",
      "maze_file",
      "distance_to_exit",
      "distance_to_food",
      "cube_solved",
      "current_floor",
      "target_blocks",
      "matched_blocks"
    ]
  },
  "meta_agent": {
    "backbone": "cli:claude",
    "timeout_s": 10800
  }
}
